# Banco de dados PostgreSQL
DATABASE_URL=postgresql://osmonitor_user:SUA_SENHA@localhost:5432/os_monitor?schema=public

# JWT — altere para uma string longa e aleatória em produção
JWT_SECRET=os-monitor-jwt-secret-change-me
JWT_EXPIRES_IN=8h

# Servidor
PORT=3001
HOST=0.0.0.0

# Storage — pasta na raiz do projeto (../storage a partir do backend)
STORAGE_PATH=../storage
